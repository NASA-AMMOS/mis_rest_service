<?xml version="1.0" encoding="ISO-8859-1"?>

<web-app>
  <servlet>
    <servlet-name>MISService</servlet-name>
    <servlet-class>jpl.mipl.mars.mis.MISService</servlet-class>
    <init-param>
      <param-name>debug_sampler</param-name>
      <param-value>{{ DEBUG_SAMPLER }}</param-value>
    </init-param>
    <init-param>
      <param-name>enable_s3</param-name>
      <param-value>{{ ENABLE_S3 }}</param-value>
    </init-param>
    <init-param>
      <param-name>enable_http</param-name>
      <param-value>{{ ENABLE_HTTP }}</param-value>
    </init-param>
    <init-param>
      <param-name>rdr_url_whitelist_patterns</param-name>
      <param-value>{{ RDR_URL_WHITELIST_PATTERNS }}</param-value>
    </init-param>
    <init-param>
      <param-name>fs_input_dir</param-name>
      <param-value>{{ FS_INPUT_DIR }}</param-value>
    </init-param>
    <init-param>
      <param-name>mission</param-name>
      <param-value>{{ MISSION }}</param-value>
    </init-param>
    <init-param>
      <param-name>aws_profile</param-name>
      <param-value>{{ AWS_PROFILE }}</param-value>
    </init-param>
    <init-param>
      <param-name>aws_region</param-name>
      <param-value>{{ AWS_REGION }}</param-value>
    </init-param>
    <init-param>
      <param-name>use_aws_header</param-name>
      <param-value>{{ SAMPLER_USE_AWS_HEADER }}</param-value>
    </init-param>
    <init-param>
      <param-name>cache_s3_credentials</param-name>
      <param-value>{{ CACHE_S3_CREDENTIALS }}</param-value>
    </init-param>
    <init-param>
      <param-name>max_s3_credentials_age</param-name>
      <param-value>{{ MAX_S3_CREDENTIALS_AGE }}</param-value>
    </init-param>
    <init-param>
      <param-name>ignore_subdirs</param-name>
      <param-value>{{ IGNORE_SUBDIRS }}</param-value>
    </init-param>
    <init-param>
      <param-name>sampler_max_concurrent_requests</param-name>
      <param-value>{{ SAMPLER_MAX_CONCURRENT_REQUESTS }}</param-value>
    </init-param>
    <init-param>
      <param-name>surface_histogram_bin_width</param-name>
      <param-value>{{ SURFACE_HISTOGRAM_BIN_WIDTH }}</param-value>
    </init-param>
    <init-param>
      <param-name>surface_histogram_max_bins</param-name>
      <param-value>{{ SURFACE_HISTOGRAM_MAX_BINS }}</param-value>
    </init-param>
    <init-param>
      <param-name>max_cached_samples</param-name>
      <param-value>{{ MAX_CACHED_SAMPLES }}</param-value>
    </init-param>
    <init-param>
      <param-name>max_cached_record_bytes</param-name>
      <param-value>{{ MAX_CACHED_RECORD_BYTES }}</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>MISService</servlet-name>
    <url-pattern>/*</url-pattern>
  </servlet-mapping>
</web-app>
